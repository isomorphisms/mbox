#!/usr/bin/env ysh

source source/mbox.ysh

var mailbox = read_mbox('corpus/basic.mbox')
var bytes = mailbox.bytes
var messages = mailbox.messages

assert [3 === len(messages)]
assert [header_values(messages[0], 'SUBJECT') === ['first']]
assert [header_values(messages[1], 'subject') === ['folded recipients']]
assert [header_values(messages[2], 'Subject') === ['leave here']]

var first_recipients = recipients(messages[0])
assert [1 === len(first_recipients)]
assert ['spec-list@example.org' === first_recipients[0].addr_spec]

var second_recipients = recipients(messages[1])
assert [3 === len(second_recipients)]
assert ['Example, Person' === second_recipients[0].display_name]
assert ['person@example.org' === second_recipients[0].addr_spec]
assert ['spec-list@example.org' === second_recipients[1].addr_spec]
assert ['other@example.org' === second_recipients[2].addr_spec]

var domain_folded_match = addr_spec_matches_domain_fold(
  'spec-list@EXAMPLE.ORG',
  'spec-list@example.org'
)
assert [domain_folded_match === true]
var local_part_differs = addr_spec_matches_domain_fold(
  'SPEC-LIST@example.org',
  'spec-list@example.org'
)
assert [local_part_differs === false]

var first_body = range_bytes(bytes, messages[0].body_range)
assert [first_body.contains('>From this is body text')]

var to_field = null
for field in (messages[1].headers) {
  if (field.name === 'to') {
    setvar to_field = field
    break
  }
}
assert [to_field !== null]
var expected_raw_to = (
  'To: "Example, Person" <person@example.org>,' ++ b'\y0a' ++
  ' SPEC-LIST <spec-list@example.org>' ++ b'\y0a'
)
var expected_raw_to_value = (
  ' "Example, Person" <person@example.org>,' ++ b'\y0a' ++
  ' SPEC-LIST <spec-list@example.org>'
)
assert [header_raw_bytes(bytes, to_field) === expected_raw_to]
assert [header_raw_value_bytes(bytes, to_field) === expected_raw_to_value]

var edge = (
  b'From edge@example.org Tue Sep 29 12:03:00 2026\r\n' ++
  b'X-Good: one\r\n' ++
  b' two\r\n' ++
  b'broken header\r\n' ++
  b'\r\n' ++
  b'body\y00bytes\r\n'
)

var edge_messages = parse_mbox(edge)
assert [1 === len(edge_messages)]
var edge_message = edge_messages[0]
assert [2 === len(edge_message.headers)]
assert ['one two' === edge_message.headers[0].unfolded_value]
assert [edge_message.headers[0].malformed === false]
assert [edge_message.headers[1].malformed === true]
assert [range_bytes(edge, edge_message.body_range) === b'body\y00bytes\r\n']

write 'PASS Grease mbox parser'
