module Mail.Source

import Data.Bits
import Data.List
import Data.Text

-- This module is the narrow representation boundary.  Domain modules should
-- carry SourceSlice and protocol-specific semantic values, not Bits8.

public export
record OctetOffset where
    constructor AtOctet
    number : Number

public export
record OctetRange where
    constructor Octets
    start : OctetOffset
    end : OctetOffset

public export
record ByteCount where
    constructor CountBytes
    number : Number

public export
data DigestAlgorithm = SHA256

public export
record SourceDigest where
    constructor Digest
    algorithm : DigestAlgorithm
    hexadecimal : Text

public export
record SourceIdentity where
    constructor Source
    byte_count : ByteCount
    digest : SourceDigest

public export
record SourceSlice where
    constructor Slice
    source : SourceIdentity
    range : OctetRange

-- Before parsing, the only honest semantic fact about one stored unit is that
-- it is one octet of this mail source.  Bits8 is hidden behind this boundary.
export
record MailSourceOctet where
    constructor SourceOctet
    representation : Bits8

export
source_octet : Bits8 → MailSourceOctet
source_octet = SourceOctet

export
same_source_octet : MailSourceOctet → MailSourceOctet → Bool
same_source_octet (SourceOctet left) (SourceOctet right) = left ≟ right

source_octet_code : MailSourceOctet → Integer
source_octet_code (SourceOctet octet) = cast octet

export
same_source_octet_ascii_case_insensitive : MailSourceOctet → MailSourceOctet → Bool
same_source_octet_ascii_case_insensitive left right =
    ascii_fold (source_octet_code left) == ascii_fold (source_octet_code right)
  where
    ascii_fold : Integer → Integer
    ascii_fold code =
        if code >= 65 && code <= 90
           then code + 32
           else code

-- These questions live at the representation boundary.  Callers use them only
-- to refine an undecided source octet into a semantic RFC terminal.
export
source_octet_is_ascii_visible : MailSourceOctet → Bool
source_octet_is_ascii_visible octet =
    let code = source_octet_code octet
    in code >= 33 && code <= 126

export
source_octet_is_ascii_letter : MailSourceOctet → Bool
source_octet_is_ascii_letter octet =
    let code = source_octet_code octet
    in (code >= 65 && code <= 90) || (code >= 97 && code <= 122)

export
source_octet_is_ascii_digit : MailSourceOctet → Bool
source_octet_is_ascii_digit octet =
    let code = source_octet_code octet
    in code >= 48 && code <= 57

public export
record OneOrMore a where
    constructor OneThen
    first : a
    rest : List a

public export
record Two a where
    constructor PairOf
    first : a
    second : a

public export
record TwoOrMore a where
    constructor TwoThen
    first : a
    second : a
    rest : List a

public export
record Four a where
    constructor FourOf
    first : a
    second : a
    third : a
    fourth : a
