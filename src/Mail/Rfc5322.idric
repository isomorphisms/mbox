    constructor HistoricalCcField
    source : SourceSlice

public export
record ObsoleteBccField where
    constructor HistoricalBccField
    source : SourceSlice

public export
record ObsoleteMessageIdField where
    constructor HistoricalMessageIdField
    source : SourceSlice

public export
record ObsoleteInReplyToField where
    constructor HistoricalInReplyToField
    source : SourceSlice

public export
record ObsoleteReferencesField where
    constructor HistoricalReferencesField
    source : SourceSlice

public export
record ObsoleteSubjectField where
    constructor HistoricalSubjectField
    source : SourceSlice

public export
record ObsoleteCommentsField where
    constructor HistoricalCommentsField
    source : SourceSlice

public export
record ObsoleteKeywordsField where
    constructor HistoricalKeywordsField
    source : SourceSlice

