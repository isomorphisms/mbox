    source : SourceSlice

public export
record ObsoleteDomainList where
    constructor HistoricalDomainList
    source : SourceSlice

public export
record ObsoleteFields where
    constructor HistoricalFields
    source : SourceSlice

public export
record ObsoleteOriginationDateField where
    constructor HistoricalOriginationDateField
    source : SourceSlice

public export
record ObsoleteFromField where
    constructor HistoricalFromField
    source : SourceSlice

public export
record ObsoleteSenderField where
    constructor HistoricalSenderField
    source : SourceSlice

public export
record ObsoleteReplyToField where
    constructor HistoricalReplyToField
    source : SourceSlice

