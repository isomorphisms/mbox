record ObsoleteResentFromField where
    constructor HistoricalResentFromField
    source : SourceSlice

public export
record ObsoleteResentSenderField where
    constructor HistoricalResentSenderField
    source : SourceSlice

public export
record ObsoleteResentDateField where
    constructor HistoricalResentDateField
    source : SourceSlice

public export
record ObsoleteResentToField where
    constructor HistoricalResentToField
    source : SourceSlice

public export
record ObsoleteResentCcField where
    constructor HistoricalResentCcField
    source : SourceSlice

public export
record ObsoleteResentBccField where
    constructor HistoricalResentBccField
    source : SourceSlice

public export
record ObsoleteResentMessageIdField where
    constructor HistoricalResentMessageIdField
    source : SourceSlice

public export
record ObsoleteResentReplyToField where
    constructor HistoricalResentReplyToField
    source : SourceSlice

public export
record ObsoleteReturnPathField where
    constructor HistoricalReturnPathField
    source : SourceSlice

public export
record ObsoleteReceivedField where
    constructor HistoricalReceivedField
    source : SourceSlice

public export
record ObsoleteOptionalField where
    constructor HistoricalOptionalField
    source : SourceSlice

public export
record ProductionName where
    constructor RfcProduction
    spelling : Text

public export
record HeaderDefect where
    constructor Rfc5322Defect
    source : SourceSlice
    expected_production : ProductionName
    observed : SourceSlice
