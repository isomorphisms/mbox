module Mail.Mbox

import Data.Bits
import Data.List
import Mail.Source
import Mail.Rfc5234
import Mail.Rfc5322

-- The mbox container has its own semantics.  Its separator line is not the
-- RFC 5322 From field.

public export
record EnvelopeLine where
    constructor MboxEnvelopeLine
    source : SourceSlice

public export
data StoredLineEnding
    = RfcLineEnding CRLF
    | BareLineFeedAcceptedByMbox LineFeed

public export
data StoredHeaderMaterial
    = ParsedHeaderField HeaderField
    | DefectiveHeaderMaterial SourceSlice (OneOrMore HeaderDefect)

public export
record MessageView where
    constructor Message
    envelope : SourceSlice
    message : SourceSlice
    header_section : SourceSlice
    body : SourceSlice
    headers : List StoredHeaderMaterial

public export
record MboxCursor where
    constructor Cursor
    source : SourceIdentity
    next_octet : OctetOffset

public export
data EnvelopePrefixProgress
    = SawF
    | SawFr
    | SawFro
    | SawFrom

record EnvelopeCandidate where
    constructor Candidate
    begins_at : OctetOffset
    progress : EnvelopePrefixProgress

public export
data FramingEvent
    = EnvelopeBegins OctetOffset
    | MessageEnds OctetOffset

record FramerState where
    constructor Framer
    next_offset : OctetOffset
    at_line_start : Bool
    envelope_candidate : Maybe EnvelopeCandidate
    open_entry : Maybe OctetOffset

record FeedResult where
    constructor Fed
    state : FramerState
    events : List FramingEvent

line_feed_octet : MailSourceOctet
line_feed_octet = source_octet 10

upper_f_octet : MailSourceOctet
upper_f_octet = source_octet 70

lower_r_octet : MailSourceOctet
lower_r_octet = source_octet 114

lower_o_octet : MailSourceOctet
lower_o_octet = source_octet 111

lower_m_octet : MailSourceOctet
lower_m_octet = source_octet 109

space_octet : MailSourceOctet
space_octet = source_octet 32

zero_offset : OctetOffset
zero_offset = AtOctet 0

advance : OctetOffset → OctetOffset
advance (AtOctet n) = AtOctet (n + 1)

is_line_feed : MailSourceOctet → Bool
is_line_feed octet = same_source_octet octet line_feed_octet

expected_separator_octet : EnvelopePrefixProgress → MailSourceOctet
expected_separator_octet SawF = lower_r_octet
expected_separator_octet SawFr = lower_o_octet
expected_separator_octet SawFro = lower_m_octet
expected_separator_octet SawFrom = space_octet

advance_separator_progress : EnvelopePrefixProgress → Maybe EnvelopePrefixProgress
advance_separator_progress SawF = Just SawFr
advance_separator_progress SawFr = Just SawFro
advance_separator_progress SawFro = Just SawFrom
advance_separator_progress SawFrom = Nothing

initial_framer : FramerState
initial_framer = Framer zero_offset True Nothing Nothing

events_for_new_envelope : Maybe OctetOffset → OctetOffset → List FramingEvent
events_for_new_envelope Nothing begins_at =
    [EnvelopeBegins begins_at]
events_for_new_envelope (Just previous) begins_at =
    [MessageEnds begins_at, EnvelopeBegins begins_at]

continue_candidate : FramerState → EnvelopeCandidate → MailSourceOctet → FeedResult
continue_candidate (Framer offset line_start candidate open_entry_start) (Candidate begins progress) octet =
        if same_source_octet octet (expected_separator_octet progress)
           then
               case advance_separator_progress progress of
                   Nothing =>
                       Fed
                           (Framer
                               (advance offset)
                               False
                               Nothing
                               (Just begins))
                           (events_for_new_envelope open_entry_start begins)
                   Just next_progress =>
                       Fed
                           (Framer
                               (advance offset)
                               False
                               (Just (Candidate begins next_progress))
                               open_entry_start)
                           []
           else
               Fed
                   (Framer
                       (advance offset)
                       (is_line_feed octet)
                       Nothing
                       open_entry_start)
                   []

start_or_skip : FramerState → MailSourceOctet → FeedResult
start_or_skip (Framer offset line_start candidate open_entry_start) octet =
        if line_start && same_source_octet octet upper_f_octet
           then
               Fed
                   (Framer
                       (advance offset)
                       False
                       (Just (Candidate offset SawF))
                       open_entry_start)
                   []
           else
               Fed
                   (Framer
                       (advance offset)
                       (is_line_feed octet)
                       Nothing
                       open_entry_start)
                   []

feed_octet : FramerState → MailSourceOctet → FeedResult
feed_octet state octet =
    case envelope_candidate state of
        Nothing => start_or_skip state octet
        Just candidate => continue_candidate state candidate octet

feed_octets : FramerState → List MailSourceOctet → FeedResult
feed_octets current_state [] = Fed current_state []
feed_octets current_state (octet :: rest) =
    case feed_octet current_state octet of
        Fed next_state first_events =>
            case feed_octets next_state rest of
                Fed final_state later_events =>
                    Fed final_state (first_events ++ later_events)

finish_framing : FramerState → List FramingEvent
finish_framing state =
    case open_entry state of
        Nothing => []
        Just begins => [MessageEnds (next_offset state)]

export
frame_octets : List MailSourceOctet → List FramingEvent
frame_octets octets =
    case feed_octets initial_framer octets of
        Fed final_state events => events ++ finish_framing final_state

same_offset : OctetOffset → OctetOffset → Bool
same_offset (AtOctet left) (AtOctet right) = left ≟ right

same_event : FramingEvent → FramingEvent → Bool
same_event (EnvelopeBegins left) (EnvelopeBegins right) = same_offset left right
same_event (MessageEnds left) (MessageEnds right) = same_offset left right
same_event _ _ = False

public export
same_events : List FramingEvent → List FramingEvent → Bool
same_events [] [] = True
same_events [] (_ :: _) = False
same_events (_ :: _) [] = False
same_events (left :: left_rest) (right :: right_rest) =
    same_event left right && same_events left_rest right_rest

public export
frame_codes : List Bits8 → List FramingEvent
frame_codes codes = frame_octets (map source_octet codes)

public export
frame_codes_chunks :
    List Bits8 →
    List Bits8 →
    List FramingEvent
frame_codes_chunks first second =
    case feed_octets initial_framer (map source_octet first) of
        Fed first_state first_events =>
            case feed_octets first_state (map source_octet second) of
                Fed second_state second_events =>
                    first_events
                    ++ second_events
                    ++ finish_framing second_state

-- Header parsing descends through Mail.Rfc5322.  The container layer only
-- establishes exact source ranges and storage-specific tolerances.


-- Opaque streaming facade over the same framer used by frame_octets.
-- Callers can carry the continuation state without depending on its internal
-- separator-prefix representation.
export
data StreamingFramer = StreamFramer FramerState

public export
record StreamingFramingStep where
    constructor AdvancedFraming
    continuation : StreamingFramer
    events : List FramingEvent

export
start_streaming_framer : StreamingFramer
start_streaming_framer = StreamFramer initial_framer

export
feed_streaming_framer :
    StreamingFramer →
    MailSourceOctet →
    StreamingFramingStep
feed_streaming_framer (StreamFramer state) octet =
    case feed_octet state octet of
        Fed next_state events =>
            AdvancedFraming
                (StreamFramer next_state)
                events

export
finish_streaming_framer :
    StreamingFramer →
    List FramingEvent
finish_streaming_framer (StreamFramer state) =
    finish_framing state
