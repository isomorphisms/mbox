module Mail.Rfc5322.Lexer

import Data.List
import Mail.Source
import Mail.Rfc5234
import Mail.Rfc5322

-- A parser cursor belongs to one immutable source snapshot.  The remaining
-- octets are still undecided source material; successful recognizers refine
-- them into RFC-named values carrying exact SourceSlice provenance.
public export
record LexerCursor where
    constructor AtMailSource
    snapshot : SourceIdentity
    next_octet : OctetOffset
    remaining : List MailSourceOctet

public export
record Parsed a where
    constructor ParsedValue
    value : a
    after : LexerCursor

record WhiteSpaceScan where
    constructor ScannedWhiteSpace
    values : List WhiteSpace
    after : LexerCursor

record FieldTextScan where
    constructor ScannedFieldText
    values : List FieldText
    after : LexerCursor

record AtextScan where
    constructor ScannedAtext
    values : List Atext
    after : LexerCursor

public export
record HeaderFieldSeparator where
    constructor SeparatesHeaderFieldName
    source : SourceSlice

public export
record HeaderFieldPrefix where
    constructor BeginsHeaderField
    source : SourceSlice
    name : FieldName
    separator : HeaderFieldSeparator

public export
record ObsoleteHeaderFieldPrefix where
    constructor BeginsHistoricalHeaderField
    source : SourceSlice
    name : FieldName
    white_space_before_separator : OneOrMore WhiteSpace
    separator : HeaderFieldSeparator

space_octet : MailSourceOctet
space_octet = source_octet 32

horizontal_tab_octet : MailSourceOctet
horizontal_tab_octet = source_octet 9

carriage_return_octet : MailSourceOctet
carriage_return_octet = source_octet 13

line_feed_octet : MailSourceOctet
line_feed_octet = source_octet 10

colon_octet : MailSourceOctet
colon_octet = source_octet 58

comma_octet : MailSourceOctet
comma_octet = source_octet 44

semicolon_octet : MailSourceOctet
semicolon_octet = source_octet 59

full_stop_octet : MailSourceOctet
full_stop_octet = source_octet 46

at_sign_octet : MailSourceOctet
at_sign_octet = source_octet 64

double_quote_octet : MailSourceOctet
double_quote_octet = source_octet 34

reverse_solidus_octet : MailSourceOctet
reverse_solidus_octet = source_octet 92

left_square_bracket_octet : MailSourceOctet
left_square_bracket_octet = source_octet 91

right_square_bracket_octet : MailSourceOctet
right_square_bracket_octet = source_octet 93

left_parenthesis_octet : MailSourceOctet
left_parenthesis_octet = source_octet 40

right_parenthesis_octet : MailSourceOctet
right_parenthesis_octet = source_octet 41

left_angle_bracket_octet : MailSourceOctet
left_angle_bracket_octet = source_octet 60

right_angle_bracket_octet : MailSourceOctet
right_angle_bracket_octet = source_octet 62

exclamation_mark_octet : MailSourceOctet
exclamation_mark_octet = source_octet 33

number_sign_octet : MailSourceOctet
number_sign_octet = source_octet 35

dollar_sign_octet : MailSourceOctet
dollar_sign_octet = source_octet 36

percent_sign_octet : MailSourceOctet
percent_sign_octet = source_octet 37

ampersand_octet : MailSourceOctet
ampersand_octet = source_octet 38

apostrophe_octet : MailSourceOctet
apostrophe_octet = source_octet 39

asterisk_octet : MailSourceOctet
asterisk_octet = source_octet 42

plus_sign_octet : MailSourceOctet
plus_sign_octet = source_octet 43

hyphen_minus_octet : MailSourceOctet
hyphen_minus_octet = source_octet 45

solidus_octet : MailSourceOctet
solidus_octet = source_octet 47

equals_sign_octet : MailSourceOctet
equals_sign_octet = source_octet 61

question_mark_octet : MailSourceOctet
question_mark_octet = source_octet 63

circumflex_accent_octet : MailSourceOctet
circumflex_accent_octet = source_octet 94

low_line_octet : MailSourceOctet
low_line_octet = source_octet 95

grave_accent_octet : MailSourceOctet
grave_accent_octet = source_octet 96

left_curly_bracket_octet : MailSourceOctet
left_curly_bracket_octet = source_octet 123

vertical_line_octet : MailSourceOctet
vertical_line_octet = source_octet 124

right_curly_bracket_octet : MailSourceOctet
right_curly_bracket_octet = source_octet 125

tilde_octet : MailSourceOctet
tilde_octet = source_octet 126

advance_offset : OctetOffset → OctetOffset
advance_offset (AtOctet n) = AtOctet (n + 1)

slice_between : SourceIdentity → OctetOffset → OctetOffset → SourceSlice
slice_between source begins ends =
    Slice source (Octets begins ends)

single_octet_slice : SourceIdentity → OctetOffset → SourceSlice
single_octet_slice source begins =
    slice_between source begins (advance_offset begins)

white_space_at : SourceIdentity → OctetOffset → MailSourceOctet → Maybe WhiteSpace
white_space_at source offset octet =
    if same_source_octet octet space_octet
       then Just (Space (single_octet_slice source offset))
       else if same_source_octet octet horizontal_tab_octet
               then Just (HorizontalTab (single_octet_slice source offset))
               else Nothing

scan_white_space_from : SourceIdentity → OctetOffset → List MailSourceOctet → List WhiteSpace → WhiteSpaceScan
scan_white_space_from source offset [] accumulated =
    ScannedWhiteSpace
        (reverse accumulated)
        (AtMailSource source offset [])
scan_white_space_from source offset all_octets@(octet :: rest) accumulated =
    case white_space_at source offset octet of
        Nothing =>
            ScannedWhiteSpace
                (reverse accumulated)
                (AtMailSource source offset all_octets)
        Just white_space =>
            scan_white_space_from
                source
                (advance_offset offset)
                rest
                (white_space :: accumulated)

scan_white_space : LexerCursor → WhiteSpaceScan
scan_white_space (AtMailSource source offset octets) =
    scan_white_space_from source offset octets []

as_one_or_more : List a → Maybe (OneOrMore a)
as_one_or_more [] = Nothing
as_one_or_more (first :: rest) = Just (OneThen first rest)

read_crlf : LexerCursor → Maybe (Parsed CRLF)
read_crlf
    (AtMailSource source begins
        (carriage_return :: line_feed :: rest)) =
            if same_source_octet carriage_return carriage_return_octet
               && same_source_octet line_feed line_feed_octet
               then
                   let middle = advance_offset begins
                       ends = advance_offset middle
                       carriage_return_slice =
                           slice_between source begins middle
                       line_feed_slice =
                           slice_between source middle ends
                       whole = slice_between source begins ends
                   in Just $
                        ParsedValue
                            (InternetLineEnding
                                whole
                                (CR carriage_return_slice)
                                (LF line_feed_slice))
                            (AtMailSource source ends rest)
               else Nothing
read_crlf _ = Nothing

read_white_space : LexerCursor → Maybe (Parsed WhiteSpace)
read_white_space (AtMailSource source begins (octet :: rest)) =
    case white_space_at source begins octet of
        Nothing => Nothing
        Just value =>
            Just $
                ParsedValue
                    value
                    (AtMailSource source (advance_offset begins) rest)
read_white_space _ = Nothing

read_white_space_run : LexerCursor → Maybe (Parsed (OneOrMore WhiteSpace))
read_white_space_run cursor =
    case scan_white_space cursor of
        ScannedWhiteSpace values after =>
            case as_one_or_more values of
                Nothing => Nothing
                Just run => Just (ParsedValue run after)

-- RFC 5322 section 3.2.2:
--
--   FWS = ([*WSP CRLF] 1*WSP) / obs-FWS
--
-- This recognizer handles only the current production.  Obsolete FWS is a
-- separate parser because accepting it must remain visible in the result type.
read_current_folding_white_space : LexerCursor → Maybe (Parsed FoldingWhiteSpace)
read_current_folding_white_space cursor@(AtMailSource source begins octets) =
    case scan_white_space cursor of
        ScannedWhiteSpace leading after_leading =>
            case read_crlf after_leading of
                Just (ParsedValue line_ending after_line_ending) =>
                    case read_white_space_run after_line_ending of
                        Just (ParsedValue trailing after_trailing) =>
                            Just $
                                ParsedValue
                                    (CurrentFWS $
                                        FoldedFWS
                                            (slice_between
                                                source
                                                begins
                                                (next_octet after_trailing))
                                            leading
                                            line_ending
                                            trailing)
                                    after_trailing
                        Nothing =>
                            single_line_fws source begins leading after_leading
                Nothing =>
                    single_line_fws source begins leading after_leading
  where
    single_line_fws :
        SourceIdentity →
        OctetOffset →
        List WhiteSpace →
        LexerCursor →
        Maybe (Parsed FoldingWhiteSpace)
    single_line_fws source begins values after =
        case as_one_or_more values of
            Nothing => Nothing
            Just run =>
                Just $
                    ParsedValue
                        (CurrentFWS $
                            SingleLineFWS
                                (slice_between
                                    source
                                    begins
                                    (next_octet after))
                                run)
                        after


field_text_at : SourceIdentity → OctetOffset → MailSourceOctet → Maybe FieldText
field_text_at source offset octet =
    if source_octet_is_ascii_visible octet
       && not (same_source_octet octet colon_octet)
       then Just (HeaderFieldText (single_octet_slice source offset))
       else Nothing

scan_field_text_from : SourceIdentity → OctetOffset → List MailSourceOctet → List FieldText → FieldTextScan
scan_field_text_from source offset [] accumulated =
    ScannedFieldText
        (reverse accumulated)
        (AtMailSource source offset [])
scan_field_text_from source offset all_octets@(octet :: rest) accumulated =
    case field_text_at source offset octet of
        Nothing =>
            ScannedFieldText
                (reverse accumulated)
                (AtMailSource source offset all_octets)
        Just field_text =>
            scan_field_text_from
                source
                (advance_offset offset)
                rest
                (field_text :: accumulated)

read_field_name : LexerCursor → Maybe (Parsed FieldName)
read_field_name cursor@(AtMailSource source begins octets) =
    case scan_field_text_from source begins octets [] of
        ScannedFieldText values after =>
            case as_one_or_more values of
                Nothing => Nothing
                Just characters =>
                    Just $
                        ParsedValue
                            (HeaderFieldName
                                (slice_between
                                    source
                                    begins
                                    (next_octet after))
                                characters)
                            after

read_header_field_separator : LexerCursor → Maybe (Parsed HeaderFieldSeparator)
read_header_field_separator
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet colon_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (SeparatesHeaderFieldName
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_header_field_separator _ = Nothing

read_header_field_prefix : LexerCursor → Maybe (Parsed HeaderFieldPrefix)
read_header_field_prefix cursor@(AtMailSource source begins octets) =
    case read_field_name cursor of
        Nothing => Nothing
        Just (ParsedValue name after_name) =>
            case read_header_field_separator after_name of
                Nothing => Nothing
                Just (ParsedValue separator after_separator) =>
                    Just $
                        ParsedValue
                            (BeginsHeaderField
                                (slice_between
                                    source
                                    begins
                                    (next_octet after_separator))
                                name
                                separator)
                            after_separator


-- Section 4 permits white space before the colon in obsolete field syntax.
-- This recognizer requires at least one WSP so current syntax is never
-- needlessly reclassified as obsolete.
read_obsolete_header_field_prefix : LexerCursor → Maybe (Parsed ObsoleteHeaderFieldPrefix)
read_obsolete_header_field_prefix cursor@(AtMailSource source begins octets) =
    case read_field_name cursor of
        Nothing => Nothing
        Just (ParsedValue name after_name) =>
            case scan_white_space after_name of
                ScannedWhiteSpace white_space after_white_space =>
                    case as_one_or_more white_space of
                        Nothing => Nothing
                        Just historical_spacing =>
                            case read_header_field_separator after_white_space of
                                Nothing => Nothing
                                Just (ParsedValue separator after_separator) =>
                                    Just $
                                        ParsedValue
                                            (BeginsHistoricalHeaderField
                                                (slice_between
                                                    source
                                                    begins
                                                    (next_octet after_separator))
                                                name
                                                historical_spacing
                                                separator)
                                            after_separator


atext_punctuation : MailSourceOctet → Maybe AtextPunctuation
atext_punctuation octet =
    if same_source_octet octet exclamation_mark_octet then Just ExclamationMark
    else if same_source_octet octet number_sign_octet then Just NumberSign
    else if same_source_octet octet dollar_sign_octet then Just DollarSign
    else if same_source_octet octet percent_sign_octet then Just PercentSign
    else if same_source_octet octet ampersand_octet then Just Ampersand
    else if same_source_octet octet apostrophe_octet then Just Apostrophe
    else if same_source_octet octet asterisk_octet then Just Asterisk
    else if same_source_octet octet plus_sign_octet then Just PlusSign
    else if same_source_octet octet hyphen_minus_octet then Just HyphenMinus
    else if same_source_octet octet solidus_octet then Just Solidus
    else if same_source_octet octet equals_sign_octet then Just EqualsSign
    else if same_source_octet octet question_mark_octet then Just QuestionMark
    else if same_source_octet octet circumflex_accent_octet then Just CircumflexAccent
    else if same_source_octet octet low_line_octet then Just LowLine
    else if same_source_octet octet grave_accent_octet then Just GraveAccent
    else if same_source_octet octet left_curly_bracket_octet then Just LeftCurlyBracket
    else if same_source_octet octet vertical_line_octet then Just VerticalLine
    else if same_source_octet octet right_curly_bracket_octet then Just RightCurlyBracket
    else if same_source_octet octet tilde_octet then Just Tilde
    else Nothing

atext_at : SourceIdentity → OctetOffset → MailSourceOctet → Maybe Atext
atext_at source offset octet =
    let source_character = single_octet_slice source offset
    in if source_octet_is_ascii_letter octet
          then Just (AtextLetter (Alphabetic source_character))
          else if source_octet_is_ascii_digit octet
                  then Just (AtextDigit (DecimalDigit source_character))
                  else case atext_punctuation octet of
                           Nothing => Nothing
                           Just punctuation =>
                               Just (AtextMark source_character punctuation)

scan_atext_from : SourceIdentity → OctetOffset → List MailSourceOctet → List Atext → AtextScan
scan_atext_from source offset [] accumulated =
    ScannedAtext
        (reverse accumulated)
        (AtMailSource source offset [])
scan_atext_from source offset all_octets@(octet :: rest) accumulated =
    case atext_at source offset octet of
        Nothing =>
            ScannedAtext
                (reverse accumulated)
                (AtMailSource source offset all_octets)
        Just value =>
            scan_atext_from
                source
                (advance_offset offset)
                rest
                (value :: accumulated)

read_atext : LexerCursor → Maybe (Parsed Atext)
read_atext (AtMailSource source begins (octet :: rest)) =
    case atext_at source begins octet of
        Nothing => Nothing
        Just value =>
            Just $
                ParsedValue
                    value
                    (AtMailSource source (advance_offset begins) rest)
read_atext _ = Nothing

read_atext_run : LexerCursor → Maybe (Parsed AtextRun)
read_atext_run cursor@(AtMailSource source begins octets) =
    case scan_atext_from source begins octets [] of
        ScannedAtext values after =>
            case as_one_or_more values of
                Nothing => Nothing
                Just characters =>
                    Just $
                        ParsedValue
                            (RunOfAtext
                                (slice_between
                                    source
                                    begins
                                    (next_octet after))
                                characters)
                            after

record DotAtomTailScan where
    constructor ScannedDotAtomTail
    parts : List DotAtomPart
    after : LexerCursor

-- The first argument is termination fuel only.  Each accepted ".atext" tail
-- consumes at least one source octet, while the structurally smaller fuel list
-- gives the totality checker independent evidence that recursion terminates.
scan_dot_atom_tail : List MailSourceOctet → LexerCursor → List DotAtomPart → DotAtomTailScan
scan_dot_atom_tail [] cursor accumulated =
    ScannedDotAtomTail (reverse accumulated) cursor
scan_dot_atom_tail (_ :: fuel) cursor@(AtMailSource source offset octets) accumulated =
    case octets of
        [] => ScannedDotAtomTail (reverse accumulated) cursor
        octet :: rest =>
            if same_source_octet octet full_stop_octet
               then
                   let separator_source =
                           single_octet_slice source offset
                       after_dot =
                           AtMailSource source (advance_offset offset) rest
                   in case read_atext_run after_dot of
                          Nothing =>
                              ScannedDotAtomTail (reverse accumulated) cursor
                          Just (ParsedValue part after_part) =>
                              scan_dot_atom_tail
                                  fuel
                                  after_part
                                  (DottedAtextPart
                                      (DotBetweenAtextRuns separator_source)
                                      part
                                   :: accumulated)
               else ScannedDotAtomTail (reverse accumulated) cursor

read_dot_atom_text : LexerCursor → Maybe (Parsed DotAtomText)
read_dot_atom_text cursor@(AtMailSource source begins octets) =
    case read_atext_run cursor of
        Nothing => Nothing
        Just (ParsedValue first_part after_first) =>
            case scan_dot_atom_tail octets after_first [] of
                ScannedDotAtomTail later_parts after =>
                    Just $
                        ParsedValue
                            (DottedAtext
                                (slice_between
                                    source
                                    begins
                                    (next_octet after))
                                first_part
                                later_parts)
                            after


public export
record BareDotAtomAddress where
    constructor DotAtomAddress
    source : SourceSlice
    address : AddrSpec

read_dot_atom_without_cfws : LexerCursor → Maybe (Parsed DotAtom)
read_dot_atom_without_cfws cursor@(AtMailSource source begins octets) =
    case read_dot_atom_text cursor of
        Nothing => Nothing
        Just (ParsedValue text after) =>
            Just $
                ParsedValue
                    (DottedAtom
                        (slice_between
                            source
                            begins
                            (next_octet after))
                        Nothing
                        text
                        Nothing)
                    after

read_addr_spec_separator : LexerCursor → Maybe (Parsed AddrSpecSeparator)
read_addr_spec_separator
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet at_sign_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (AddressAtSign
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_addr_spec_separator _ = Nothing

-- First executable slice of RFC 5322 section 3.4.1:
--
--   addr-spec = local-part "@" domain
--
-- This recognizer implements the current dot-atom alternative on both sides.
-- Quoted-string local-parts, domain-literals, and obsolete syntax stay as
-- separate grammar branches rather than being approximated here.
read_dot_atom_addr_spec : LexerCursor → Maybe (Parsed BareDotAtomAddress)
read_dot_atom_addr_spec cursor@(AtMailSource source begins octets) =
    case read_dot_atom_without_cfws cursor of
        Nothing => Nothing
        Just (ParsedValue local_dot_atom after_local) =>
            case read_addr_spec_separator after_local of
                Nothing => Nothing
                Just (ParsedValue separator after_separator) =>
                    case read_dot_atom_without_cfws after_separator of
                        Nothing => Nothing
                        Just (ParsedValue domain_dot_atom after_domain) =>
                            let local_part =
                                    DotAtomLocalPart local_dot_atom
                                domain =
                                    DotAtomDomain domain_dot_atom
                                whole =
                                    slice_between
                                        source
                                        begins
                                        (next_octet after_domain)
                                address =
                                    InternetAddressSpecification
                                        whole
                                        local_part
                                        separator
                                        domain
                            in Just $
                                ParsedValue
                                    (DotAtomAddress whole address)
                                    after_domain


read_double_quote : LexerCursor → Maybe (Parsed DQuote)
read_double_quote (AtMailSource source begins (octet :: rest)) =
    if same_source_octet octet double_quote_octet
       then
           let ends = advance_offset begins
           in Just $
                ParsedValue
                    (DoubleQuote (slice_between source begins ends))
                    (AtMailSource source ends rest)
       else Nothing
read_double_quote _ = Nothing

quoted_text_at : SourceIdentity → OctetOffset → MailSourceOctet → Maybe QuotedText
quoted_text_at source offset octet =
    if source_octet_is_ascii_visible octet
       && not (same_source_octet octet double_quote_octet)
       && not (same_source_octet octet reverse_solidus_octet)
       then Just $
            CurrentQuotedText (single_octet_slice source offset)
       else Nothing

read_current_quoted_pair : LexerCursor → Maybe (Parsed QuotedPair)
read_current_quoted_pair
    (AtMailSource source begins (escape_octet :: payload_octet :: rest)) =
        if same_source_octet escape_octet reverse_solidus_octet
           then
               let payload_offset = advance_offset begins
                   ends = advance_offset payload_offset
                   escape_source =
                       single_octet_slice source begins
                   payload_source =
                       single_octet_slice source payload_offset
                   whole =
                       slice_between source begins ends
                   payload =
                       case white_space_at source payload_offset payload_octet of
                           Just white_space =>
                               Just (QuotedWhiteSpace white_space)
                           Nothing =>
                               if source_octet_is_ascii_visible payload_octet
                                  then Just $
                                       QuotedVisibleCharacter
                                           (Visible payload_source)
                                  else Nothing
               in case payload of
                      Nothing => Nothing
                      Just quoted_payload =>
                          Just $
                              ParsedValue
                                  (CurrentQuotedPairSyntax $
                                      CurrentQuotedPairStructure
                                          whole
                                          (QuotedPairReverseSolidus escape_source)
                                          quoted_payload)
                                  (AtMailSource source ends rest)
           else Nothing
read_current_quoted_pair _ = Nothing

read_current_quoted_content : LexerCursor → Maybe (Parsed QuotedContent)
read_current_quoted_content
    cursor@(AtMailSource source begins (octet :: rest)) =
        case quoted_text_at source begins octet of
            Just quoted_text =>
                Just $
                    ParsedValue
                        (QuotedCharacters quoted_text)
                        (AtMailSource source (advance_offset begins) rest)
            Nothing =>
                case read_current_quoted_pair cursor of
                    Nothing => Nothing
                    Just (ParsedValue quoted_pair after) =>
                        Just $
                            ParsedValue
                                (QuotedCharacterPair quoted_pair)
                                after
read_current_quoted_content _ = Nothing

record QuotedStringScan where
    constructor ScannedQuotedString
    parts : List QuotedStringPart
    final_folding_white_space : Maybe FoldingWhiteSpace
    after : LexerCursor

scan_current_quoted_string :
    List MailSourceOctet →
    LexerCursor →
    List QuotedStringPart →
    QuotedStringScan
scan_current_quoted_string [] cursor accumulated =
    ScannedQuotedString (reverse accumulated) Nothing cursor
scan_current_quoted_string (_ :: fuel) cursor accumulated =
    case read_current_folding_white_space cursor of
        Just (ParsedValue folding_white_space after_fws) =>
            case read_current_quoted_content after_fws of
                Nothing =>
                    ScannedQuotedString
                        (reverse accumulated)
                        (Just folding_white_space)
                        after_fws
                Just (ParsedValue content after_content) =>
                    scan_current_quoted_string
                        fuel
                        after_content
                        (QuotedPart (Just folding_white_space) content
                         :: accumulated)
        Nothing =>
            case read_current_quoted_content cursor of
                Nothing =>
                    ScannedQuotedString
                        (reverse accumulated)
                        Nothing
                        cursor
                Just (ParsedValue content after_content) =>
                    scan_current_quoted_string
                        fuel
                        after_content
                        (QuotedPart Nothing content :: accumulated)

-- Current quoted-string without the optional outer CFWS.  The internal grammar
-- is complete for current RFC 5322: qtext, quoted-pair, and FWS are retained as
-- distinct semantic values.  Outer comments/CFWS are a separate parser layer.
read_quoted_string_without_cfws : LexerCursor → Maybe (Parsed QuotedString)
read_quoted_string_without_cfws
    cursor@(AtMailSource source begins octets) =
        case read_double_quote cursor of
            Nothing => Nothing
            Just (ParsedValue opening_quote after_opening) =>
                case scan_current_quoted_string
                         octets
                         after_opening
                         [] of
                    ScannedQuotedString
                        parts
                        final_fws
                        before_closing =>
                            case read_double_quote before_closing of
                                Nothing => Nothing
                                Just (ParsedValue closing_quote after_closing) =>
                                    Just $
                                        ParsedValue
                                            (Quoted
                                                (slice_between
                                                    source
                                                    begins
                                                    (next_octet after_closing))
                                                Nothing
                                                opening_quote
                                                parts
                                                final_fws
                                                closing_quote
                                                Nothing)
                                            after_closing


read_current_local_part_without_cfws : LexerCursor → Maybe (Parsed LocalPart)
read_current_local_part_without_cfws cursor =
    case read_dot_atom_without_cfws cursor of
        Just (ParsedValue dot_atom after) =>
            Just $
                ParsedValue
                    (DotAtomLocalPart dot_atom)
                    after
        Nothing =>
            case read_quoted_string_without_cfws cursor of
                Nothing => Nothing
                Just (ParsedValue quoted_string after) =>
                    Just $
                        ParsedValue
                            (QuotedLocalPart quoted_string)
                            after

read_current_dot_atom_domain_without_cfws : LexerCursor → Maybe (Parsed Domain)
read_current_dot_atom_domain_without_cfws cursor =
    case read_dot_atom_without_cfws cursor of
        Nothing => Nothing
        Just (ParsedValue dot_atom after) =>
            Just $
                ParsedValue
                    (DotAtomDomain dot_atom)
                    after

-- Current addr-spec with every RFC 5322 local-part alternative implemented so
-- far (dot-atom or quoted-string) and the dot-atom domain branch.  Domain
-- literals and obsolete domains are intentionally separate recognizers.
read_addr_spec_with_dot_atom_domain : LexerCursor → Maybe (Parsed AddrSpec)
read_addr_spec_with_dot_atom_domain
    cursor@(AtMailSource source begins octets) =
        case read_current_local_part_without_cfws cursor of
            Nothing => Nothing
            Just (ParsedValue local_part after_local) =>
                case read_addr_spec_separator after_local of
                    Nothing => Nothing
                    Just (ParsedValue separator after_separator) =>
                        case read_current_dot_atom_domain_without_cfws
                                 after_separator of
                            Nothing => Nothing
                            Just (ParsedValue domain after_domain) =>
                                let whole =
                                        slice_between
                                            source
                                            begins
                                            (next_octet after_domain)
                                in Just $
                                    ParsedValue
                                        (InternetAddressSpecification
                                            whole
                                            local_part
                                            separator
                                            domain)
                                        after_domain


read_domain_literal_opening : LexerCursor → Maybe (Parsed DomainLiteralOpeningBracket)
read_domain_literal_opening
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet left_square_bracket_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (OpensDomainLiteral
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_domain_literal_opening _ = Nothing

read_domain_literal_closing : LexerCursor → Maybe (Parsed DomainLiteralClosingBracket)
read_domain_literal_closing
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet right_square_bracket_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (ClosesDomainLiteral
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_domain_literal_closing _ = Nothing

domain_text_at : SourceIdentity → OctetOffset → MailSourceOctet → Maybe DomainText
domain_text_at source offset octet =
    if source_octet_is_ascii_visible octet
       && not (same_source_octet octet left_square_bracket_octet)
       && not (same_source_octet octet reverse_solidus_octet)
       && not (same_source_octet octet right_square_bracket_octet)
       then Just $
            CurrentDomainText (single_octet_slice source offset)
       else Nothing

read_current_domain_text : LexerCursor → Maybe (Parsed DomainText)
read_current_domain_text
    (AtMailSource source begins (octet :: rest)) =
        case domain_text_at source begins octet of
            Nothing => Nothing
            Just domain_text =>
                Just $
                    ParsedValue
                        domain_text
                        (AtMailSource source (advance_offset begins) rest)
read_current_domain_text _ = Nothing

record DomainLiteralScan where
    constructor ScannedDomainLiteral
    parts : List (Maybe FoldingWhiteSpace, DomainText)
    final_folding_white_space : Maybe FoldingWhiteSpace
    after : LexerCursor

scan_current_domain_literal :
    List MailSourceOctet →
    LexerCursor →
    List (Maybe FoldingWhiteSpace, DomainText) →
    DomainLiteralScan
scan_current_domain_literal [] cursor accumulated =
    ScannedDomainLiteral (reverse accumulated) Nothing cursor
scan_current_domain_literal (_ :: fuel) cursor accumulated =
    case read_current_folding_white_space cursor of
        Just (ParsedValue folding_white_space after_fws) =>
            case read_current_domain_text after_fws of
                Nothing =>
                    ScannedDomainLiteral
                        (reverse accumulated)
                        (Just folding_white_space)
                        after_fws
                Just (ParsedValue domain_text after_text) =>
                    scan_current_domain_literal
                        fuel
                        after_text
                        ((Just folding_white_space, domain_text)
                         :: accumulated)
        Nothing =>
            case read_current_domain_text cursor of
                Nothing =>
                    ScannedDomainLiteral
                        (reverse accumulated)
                        Nothing
                        cursor
                Just (ParsedValue domain_text after_text) =>
                    scan_current_domain_literal
                        fuel
                        after_text
                        ((Nothing, domain_text) :: accumulated)

-- Current domain-literal without optional outer CFWS.  The opening and closing
-- brackets are semantic values, not punctuation discarded by the parser.
read_domain_literal_without_cfws : LexerCursor → Maybe (Parsed DomainLiteral)
read_domain_literal_without_cfws
    cursor@(AtMailSource source begins octets) =
        case read_domain_literal_opening cursor of
            Nothing => Nothing
            Just (ParsedValue opening after_opening) =>
                case scan_current_domain_literal
                         octets
                         after_opening
                         [] of
                    ScannedDomainLiteral
                        parts
                        final_fws
                        before_closing =>
                            case read_domain_literal_closing before_closing of
                                Nothing => Nothing
                                Just (ParsedValue closing after_closing) =>
                                    Just $
                                        ParsedValue
                                            (LiteralDomain
                                                (slice_between
                                                    source
                                                    begins
                                                    (next_octet after_closing))
                                                Nothing
                                                opening
                                                parts
                                                final_fws
                                                closing
                                                Nothing)
                                            after_closing

read_current_domain_without_cfws : LexerCursor → Maybe (Parsed Domain)
read_current_domain_without_cfws cursor =
    case read_dot_atom_without_cfws cursor of
        Just (ParsedValue dot_atom after) =>
            Just $
                ParsedValue
                    (DotAtomDomain dot_atom)
                    after
        Nothing =>
            case read_domain_literal_without_cfws cursor of
                Nothing => Nothing
                Just (ParsedValue literal after) =>
                    Just $
                        ParsedValue
                            (LiteralDomainName literal)
                            after

-- Current RFC 5322 addr-spec alternatives, excluding only CFWS and section-4
-- obsolete syntax.  The local-part can be dot-atom or quoted-string; the
-- domain can be dot-atom or domain-literal.
read_current_addr_spec_without_cfws : LexerCursor → Maybe (Parsed AddrSpec)
read_current_addr_spec_without_cfws
    cursor@(AtMailSource source begins octets) =
        case read_current_local_part_without_cfws cursor of
            Nothing => Nothing
            Just (ParsedValue local_part after_local) =>
                case read_addr_spec_separator after_local of
                    Nothing => Nothing
                    Just (ParsedValue separator after_separator) =>
                        case read_current_domain_without_cfws
                                 after_separator of
                            Nothing => Nothing
                            Just (ParsedValue domain after_domain) =>
                                let whole =
                                        slice_between
                                            source
                                            begins
                                            (next_octet after_domain)
                                in Just $
                                    ParsedValue
                                        (InternetAddressSpecification
                                            whole
                                            local_part
                                            separator
                                            domain)
                                        after_domain


read_comment_opening : LexerCursor → Maybe (Parsed CommentOpeningParenthesis)
read_comment_opening
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet left_parenthesis_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (OpensComment
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_comment_opening _ = Nothing

read_comment_closing : LexerCursor → Maybe (Parsed CommentClosingParenthesis)
read_comment_closing
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet right_parenthesis_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (ClosesComment
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_comment_closing _ = Nothing

comment_text_at : SourceIdentity → OctetOffset → MailSourceOctet → Maybe CommentText
comment_text_at source offset octet =
    if source_octet_is_ascii_visible octet
       && not (same_source_octet octet left_parenthesis_octet)
       && not (same_source_octet octet right_parenthesis_octet)
       && not (same_source_octet octet reverse_solidus_octet)
       then Just $
            CurrentCommentText (single_octet_slice source offset)
       else Nothing

read_current_comment_text : LexerCursor → Maybe (Parsed CommentText)
read_current_comment_text
    (AtMailSource source begins (octet :: rest)) =
        case comment_text_at source begins octet of
            Nothing => Nothing
            Just comment_text =>
                Just $
                    ParsedValue
                        comment_text
                        (AtMailSource source (advance_offset begins) rest)
read_current_comment_text _ = Nothing

record CommentScan where
    constructor ScannedComment
    parts : List CommentPart
    final_folding_white_space : Maybe FoldingWhiteSpace
    after : LexerCursor

mutual
    read_current_comment_with_fuel :
        List MailSourceOctet →
        LexerCursor →
        Maybe (Parsed Comment)
    read_current_comment_with_fuel [] cursor = Nothing
    read_current_comment_with_fuel (_ :: fuel)
        cursor@(AtMailSource source begins octets) =
            case read_comment_opening cursor of
                Nothing => Nothing
                Just (ParsedValue opening after_opening) =>
                    case scan_current_comment
                             fuel
                             after_opening
                             [] of
                        ScannedComment parts final_fws before_closing =>
                            case read_comment_closing before_closing of
                                Nothing => Nothing
                                Just (ParsedValue closing after_closing) =>
                                    Just $
                                        ParsedValue
                                            (ParenthesizedComment
                                                (slice_between
                                                    source
                                                    begins
                                                    (next_octet after_closing))
                                                opening
                                                parts
                                                final_fws
                                                closing)
                                            after_closing

    read_current_comment_content :
        List MailSourceOctet →
        LexerCursor →
        Maybe (Parsed CommentContent)
    read_current_comment_content fuel cursor =
        case read_current_comment_text cursor of
            Just (ParsedValue text after) =>
                Just $
                    ParsedValue
                        (CommentCharacters text)
                        after
            Nothing =>
                case read_current_quoted_pair cursor of
                    Just (ParsedValue quoted_pair after) =>
                        Just $
                            ParsedValue
                                (CommentQuotedPair quoted_pair)
                                after
                    Nothing =>
                        case read_current_comment_with_fuel fuel cursor of
                            Nothing => Nothing
                            Just (ParsedValue nested after) =>
                                Just $
                                    ParsedValue
                                        (NestedComment nested)
                                        after

    scan_current_comment :
        List MailSourceOctet →
        LexerCursor →
        List CommentPart →
        CommentScan
    scan_current_comment [] cursor accumulated =
        ScannedComment (reverse accumulated) Nothing cursor
    scan_current_comment (_ :: fuel) cursor accumulated =
        case read_current_folding_white_space cursor of
            Just (ParsedValue folding_white_space after_fws) =>
                case read_current_comment_content fuel after_fws of
                    Nothing =>
                        ScannedComment
                            (reverse accumulated)
                            (Just folding_white_space)
                            after_fws
                    Just (ParsedValue content after_content) =>
                        scan_current_comment
                            fuel
                            after_content
                            (CommentPiece
                                (Just folding_white_space)
                                content
                             :: accumulated)
            Nothing =>
                case read_current_comment_content fuel cursor of
                    Nothing =>
                        ScannedComment
                            (reverse accumulated)
                            Nothing
                            cursor
                    Just (ParsedValue content after_content) =>
                        scan_current_comment
                            fuel
                            after_content
                            (CommentPiece Nothing content
                             :: accumulated)

read_current_comment : LexerCursor → Maybe (Parsed Comment)
read_current_comment
    cursor@(AtMailSource source begins octets) =
        read_current_comment_with_fuel octets cursor

record CommentSequenceScan where
    constructor ScannedCommentSequence
    comments : List (Maybe FoldingWhiteSpace, Comment)
    final_folding_white_space : Maybe FoldingWhiteSpace
    after : LexerCursor

scan_cfws_comments :
    List MailSourceOctet →
    LexerCursor →
    List (Maybe FoldingWhiteSpace, Comment) →
    CommentSequenceScan
scan_cfws_comments [] cursor accumulated =
    ScannedCommentSequence
        (reverse accumulated)
        Nothing
        cursor
scan_cfws_comments (_ :: fuel) cursor accumulated =
    case read_current_folding_white_space cursor of
        Just (ParsedValue folding_white_space after_fws) =>
            case read_current_comment after_fws of
                Just (ParsedValue comment after_comment) =>
                    scan_cfws_comments
                        fuel
                        after_comment
                        ((Just folding_white_space, comment)
                         :: accumulated)
                Nothing =>
                    case accumulated of
                        [] =>
                            ScannedCommentSequence [] Nothing cursor
                        _ =>
                            ScannedCommentSequence
                                (reverse accumulated)
                                (Just folding_white_space)
                                after_fws
        Nothing =>
            case read_current_comment cursor of
                Just (ParsedValue comment after_comment) =>
                    scan_cfws_comments
                        fuel
                        after_comment
                        ((Nothing, comment) :: accumulated)
                Nothing =>
                    ScannedCommentSequence
                        (reverse accumulated)
                        Nothing
                        cursor

read_current_cfws : LexerCursor → Maybe (Parsed CommentsAndFoldingWhiteSpace)
read_current_cfws cursor@(AtMailSource source begins octets) =
    case scan_cfws_comments octets cursor [] of
        ScannedCommentSequence [] final_fws after =>
            case read_current_folding_white_space cursor of
                Nothing => Nothing
                Just (ParsedValue folding_white_space after_fws) =>
                    Just $
                        ParsedValue
                            (FoldingWhiteSpaceOnly folding_white_space)
                            after_fws
        ScannedCommentSequence (first :: rest) final_fws after =>
            Just $
                ParsedValue
                    (CommentsWithOptionalFWS
                        (slice_between
                            source
                            begins
                            (next_octet after))
                        (OneThen first rest)
                        final_fws)
                    after


read_optional_current_cfws : LexerCursor → (Maybe CommentsAndFoldingWhiteSpace, LexerCursor)
read_optional_current_cfws cursor =
    case read_current_cfws cursor of
        Nothing => (Nothing, cursor)
        Just (ParsedValue cfws after) => (Just cfws, after)

read_current_atom : LexerCursor → Maybe (Parsed Atom)
read_current_atom cursor@(AtMailSource source begins octets) =
    let (before, after_before) =
            read_optional_current_cfws cursor
    in case read_atext_run after_before of
           Nothing => Nothing
           Just (ParsedValue text after_text) =>
               let (after_cfws, after) =
                       read_optional_current_cfws after_text
               in Just $
                   ParsedValue
                       (AtomicWord
                           (slice_between
                               source
                               begins
                               (next_octet after))
                           before
                           (characters text)
                           after_cfws)
                       after

read_current_dot_atom : LexerCursor → Maybe (Parsed DotAtom)
read_current_dot_atom cursor@(AtMailSource source begins octets) =
    let (before, after_before) =
            read_optional_current_cfws cursor
    in case read_dot_atom_text after_before of
           Nothing => Nothing
           Just (ParsedValue text after_text) =>
               let (after_cfws, after) =
                       read_optional_current_cfws after_text
               in Just $
                   ParsedValue
                       (DottedAtom
                           (slice_between
                               source
                               begins
                               (next_octet after))
                           before
                           text
                           after_cfws)
                       after

read_current_quoted_string : LexerCursor → Maybe (Parsed QuotedString)
read_current_quoted_string
    cursor@(AtMailSource source begins octets) =
        let (before, after_before) =
                read_optional_current_cfws cursor
        in case read_quoted_string_without_cfws after_before of
               Nothing => Nothing
               Just (ParsedValue
                       (Quoted
                           inner_source
                           inner_before
                           opening_quote
                           parts
                           final_fws
                           closing_quote
                           inner_after)
                       after_inner) =>
                   let (after_cfws, after) =
                           read_optional_current_cfws after_inner
                   in Just $
                       ParsedValue
                           (Quoted
                               (slice_between
                                   source
                                   begins
                                   (next_octet after))
                               before
                               opening_quote
                               parts
                               final_fws
                               closing_quote
                               after_cfws)
                           after

read_current_word : LexerCursor → Maybe (Parsed Word)
read_current_word cursor =
    case read_current_atom cursor of
        Just (ParsedValue atom after) =>
            Just (ParsedValue (AtomWord atom) after)
        Nothing =>
            case read_current_quoted_string cursor of
                Nothing => Nothing
                Just (ParsedValue quoted_string after) =>
                    Just $
                        ParsedValue
                            (QuotedWord quoted_string)
                            after

record WordScan where
    constructor ScannedWords
    words : List Word
    after : LexerCursor

scan_current_words :
    List MailSourceOctet →
    LexerCursor →
    List Word →
    WordScan
scan_current_words [] cursor accumulated =
    ScannedWords (reverse accumulated) cursor
scan_current_words (_ :: fuel) cursor accumulated =
    case read_current_word cursor of
        Nothing =>
            ScannedWords (reverse accumulated) cursor
        Just (ParsedValue word after_word) =>
            scan_current_words
                fuel
                after_word
                (word :: accumulated)

read_current_phrase : LexerCursor → Maybe (Parsed Phrase)
read_current_phrase cursor@(AtMailSource source begins octets) =
    case scan_current_words octets cursor [] of
        ScannedWords [] after => Nothing
        ScannedWords (first :: rest) after =>
            Just $
                ParsedValue
                    (CurrentPhrase
                        (slice_between
                            source
                            begins
                            (next_octet after))
                        (OneThen first rest))
                    after

read_current_display_name : LexerCursor → Maybe (Parsed DisplayName)
read_current_display_name cursor@(AtMailSource source begins octets) =
    case read_current_phrase cursor of
        Nothing => Nothing
        Just (ParsedValue phrase after) =>
            Just $
                ParsedValue
                    (DisplayedName
                        (slice_between
                            source
                            begins
                            (next_octet after))
                        phrase)
                    after

read_angle_address_opening : LexerCursor → Maybe (Parsed AngleAddressOpeningBracket)
read_angle_address_opening
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet left_angle_bracket_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (OpensAngleAddress
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_angle_address_opening _ = Nothing

read_angle_address_closing : LexerCursor → Maybe (Parsed AngleAddressClosingBracket)
read_angle_address_closing
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet right_angle_bracket_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (ClosesAngleAddress
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_angle_address_closing _ = Nothing

read_current_local_part : LexerCursor → Maybe (Parsed LocalPart)
read_current_local_part cursor =
    case read_current_dot_atom cursor of
        Just (ParsedValue dot_atom after) =>
            Just $
                ParsedValue
                    (DotAtomLocalPart dot_atom)
                    after
        Nothing =>
            case read_current_quoted_string cursor of
                Nothing => Nothing
                Just (ParsedValue quoted_string after) =>
                    Just $
                        ParsedValue
                            (QuotedLocalPart quoted_string)
                            after

read_current_domain : LexerCursor → Maybe (Parsed Domain)
read_current_domain cursor =
    case read_current_dot_atom cursor of
        Just (ParsedValue dot_atom after) =>
            Just $
                ParsedValue
                    (DotAtomDomain dot_atom)
                    after
        Nothing =>
            case read_domain_literal_without_cfws cursor of
                Nothing => Nothing
                Just (ParsedValue literal after) =>
                    Just $
                        ParsedValue
                            (LiteralDomainName literal)
                            after

read_current_addr_spec : LexerCursor → Maybe (Parsed AddrSpec)
read_current_addr_spec cursor@(AtMailSource source begins octets) =
    case read_current_local_part cursor of
        Nothing => Nothing
        Just (ParsedValue local_part after_local) =>
            case read_addr_spec_separator after_local of
                Nothing => Nothing
                Just (ParsedValue separator after_separator) =>
                    case read_current_domain after_separator of
                        Nothing => Nothing
                        Just (ParsedValue domain after_domain) =>
                            Just $
                                ParsedValue
                                    (InternetAddressSpecification
                                        (slice_between
                                            source
                                            begins
                                            (next_octet after_domain))
                                        local_part
                                        separator
                                        domain)
                                    after_domain

read_current_angle_address : LexerCursor → Maybe (Parsed AngleAddress)
read_current_angle_address
    cursor@(AtMailSource source begins octets) =
        let (before, after_before) =
                read_optional_current_cfws cursor
        in case read_angle_address_opening after_before of
               Nothing => Nothing
               Just (ParsedValue opening after_opening) =>
                   case read_current_addr_spec after_opening of
                       Nothing => Nothing
                       Just (ParsedValue address after_address) =>
                           case read_angle_address_closing after_address of
                               Nothing => Nothing
                               Just (ParsedValue closing after_closing) =>
                                   let (after_cfws, after) =
                                           read_optional_current_cfws
                                               after_closing
                                       structure =
                                           AngleAddressStructure
                                               (slice_between
                                                   source
                                                   begins
                                                   (next_octet after))
                                               before
                                               opening
                                               address
                                               closing
                                               after_cfws
                                   in Just $
                                       ParsedValue
                                           (CurrentAngleAddressSyntax structure)
                                           after

read_current_name_address : LexerCursor → Maybe (Parsed NameAddress)
read_current_name_address
    cursor@(AtMailSource source begins octets) =
        case read_current_display_name cursor of
            Just (ParsedValue display_name after_display_name) =>
                case read_current_angle_address after_display_name of
                    Nothing => Nothing
                    Just (ParsedValue angle_address after) =>
                        Just $
                            ParsedValue
                                (NamedAddress
                                    (slice_between
                                        source
                                        begins
                                        (next_octet after))
                                    (Just display_name)
                                    angle_address)
                                after
            Nothing =>
                case read_current_angle_address cursor of
                    Nothing => Nothing
                    Just (ParsedValue angle_address after) =>
                        Just $
                            ParsedValue
                                (NamedAddress
                                    (slice_between
                                        source
                                        begins
                                        (next_octet after))
                                    Nothing
                                    angle_address)
                                after

read_current_mailbox : LexerCursor → Maybe (Parsed Mailbox)
read_current_mailbox cursor =
    case read_current_name_address cursor of
        Just (ParsedValue name_address after) =>
            Just $
                ParsedValue
                    (NamedMailbox name_address)
                    after
        Nothing =>
            case read_current_addr_spec cursor of
                Nothing => Nothing
                Just (ParsedValue address_spec after) =>
                    Just $
                        ParsedValue
                            (BareMailbox address_spec)
                            after


read_mailbox_list_separator : LexerCursor → Maybe (Parsed MailboxListSeparator)
read_mailbox_list_separator
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet comma_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (SeparatesMailboxes
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_mailbox_list_separator _ = Nothing

record MailboxListTailScan where
    constructor ScannedMailboxListTail
    parts : List MailboxListPart
    after : LexerCursor

scan_current_mailbox_list_tail :
    List MailSourceOctet →
    LexerCursor →
    List MailboxListPart →
    MailboxListTailScan
scan_current_mailbox_list_tail [] cursor accumulated =
    ScannedMailboxListTail (reverse accumulated) cursor
scan_current_mailbox_list_tail (_ :: fuel) cursor accumulated =
    case read_mailbox_list_separator cursor of
        Nothing =>
            ScannedMailboxListTail (reverse accumulated) cursor
        Just (ParsedValue separator after_separator) =>
            case read_current_mailbox after_separator of
                Nothing =>
                    ScannedMailboxListTail (reverse accumulated) cursor
                Just (ParsedValue mailbox after_mailbox) =>
                    scan_current_mailbox_list_tail
                        fuel
                        after_mailbox
                        (LaterMailbox separator mailbox :: accumulated)

read_current_mailbox_list : LexerCursor → Maybe (Parsed MailboxList)
read_current_mailbox_list
    cursor@(AtMailSource source begins octets) =
        case read_current_mailbox cursor of
            Nothing => Nothing
            Just (ParsedValue first_mailbox after_first) =>
                case scan_current_mailbox_list_tail
                         octets
                         after_first
                         [] of
                    ScannedMailboxListTail later after =>
                        let structure =
                                MailboxListStructure
                                    (slice_between
                                        source
                                        begins
                                        (next_octet after))
                                    first_mailbox
                                    later
                        in Just $
                            ParsedValue
                                (CurrentMailboxListSyntax structure)
                                after

read_group_name_separator : LexerCursor → Maybe (Parsed GroupNameSeparator)
read_group_name_separator
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet colon_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (SeparatesGroupName
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_group_name_separator _ = Nothing

read_group_terminator : LexerCursor → Maybe (Parsed GroupTerminator)
read_group_terminator
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet semicolon_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (TerminatesGroup
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_group_terminator _ = Nothing

read_current_group_list : LexerCursor → Maybe (Parsed GroupList)
read_current_group_list cursor =
    case read_current_mailbox_list cursor of
        Just (ParsedValue mailboxes after) =>
            Just $
                ParsedValue
                    (GroupMailboxes mailboxes)
                    after
        Nothing =>
            case read_current_cfws cursor of
                Nothing => Nothing
                Just (ParsedValue cfws after) =>
                    Just $
                        ParsedValue
                            (GroupComments cfws)
                            after

read_current_group : LexerCursor → Maybe (Parsed Group)
read_current_group
    cursor@(AtMailSource source begins octets) =
        case read_current_display_name cursor of
            Nothing => Nothing
            Just (ParsedValue display_name after_name) =>
                case read_group_name_separator after_name of
                    Nothing => Nothing
                    Just (ParsedValue separator after_separator) =>
                        let group_list_result =
                                read_current_group_list after_separator
                            members =
                                case group_list_result of
                                    Nothing => Nothing
                                    Just (ParsedValue group_list after_members) =>
                                        Just group_list
                            before_terminator =
                                case group_list_result of
                                    Nothing => after_separator
                                    Just (ParsedValue group_list after_members) =>
                                        after_members
                        in case read_group_terminator before_terminator of
                               Nothing => Nothing
                               Just (ParsedValue terminator after_terminator) =>
                                   let (after_cfws, after) =
                                           read_optional_current_cfws
                                               after_terminator
                                   in Just $
                                       ParsedValue
                                           (AddressGroup
                                               (slice_between
                                                   source
                                                   begins
                                                   (next_octet after))
                                               display_name
                                               separator
                                               members
                                               terminator
                                               after_cfws)
                                           after

read_current_address : LexerCursor → Maybe (Parsed Address)
read_current_address cursor =
    case read_current_group cursor of
        Just (ParsedValue group after) =>
            Just $
                ParsedValue
                    (AddressGroupValue group)
                    after
        Nothing =>
            case read_current_mailbox cursor of
                Nothing => Nothing
                Just (ParsedValue mailbox after) =>
                    Just $
                        ParsedValue
                            (AddressMailbox mailbox)
                            after

read_address_list_separator : LexerCursor → Maybe (Parsed AddressListSeparator)
read_address_list_separator
    (AtMailSource source begins (octet :: rest)) =
        if same_source_octet octet comma_octet
           then
               let ends = advance_offset begins
               in Just $
                    ParsedValue
                        (SeparatesAddresses
                            (slice_between source begins ends))
                        (AtMailSource source ends rest)
           else Nothing
read_address_list_separator _ = Nothing

record AddressListTailScan where
    constructor ScannedAddressListTail
    parts : List AddressListPart
    after : LexerCursor

scan_current_address_list_tail :
    List MailSourceOctet →
    LexerCursor →
    List AddressListPart →
    AddressListTailScan
scan_current_address_list_tail [] cursor accumulated =
    ScannedAddressListTail (reverse accumulated) cursor
scan_current_address_list_tail (_ :: fuel) cursor accumulated =
    case read_address_list_separator cursor of
        Nothing =>
            ScannedAddressListTail (reverse accumulated) cursor
        Just (ParsedValue separator after_separator) =>
            case read_current_address after_separator of
                Nothing =>
                    ScannedAddressListTail (reverse accumulated) cursor
                Just (ParsedValue address after_address) =>
                    scan_current_address_list_tail
                        fuel
                        after_address
                        (LaterAddress separator address :: accumulated)

read_current_address_list : LexerCursor → Maybe (Parsed AddressList)
read_current_address_list
    cursor@(AtMailSource source begins octets) =
        case read_current_address cursor of
            Nothing => Nothing
            Just (ParsedValue first_address after_first) =>
                case scan_current_address_list_tail
                         octets
                         after_first
                         [] of
                    ScannedAddressListTail later after =>
                        let structure =
                                AddressListStructure
                                    (slice_between
                                        source
                                        begins
                                        (next_octet after))
                                    first_address
                                    later
                        in Just $
                            ParsedValue
                                (CurrentAddressListSyntax structure)
                                after
